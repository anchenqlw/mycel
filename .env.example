# Copy this file to .env.local only when overriding the local demo defaults.
# Never commit .env.local. Keep all credential values as local placeholders.

# Sanitized public demo repository and matching Mycel runtime data directory.
MYCEL_TARGET_REPO=.local/public-demo/repository
MYCEL_DATA_DIR=.local/public-demo/runtime

# Local provider CLI discovery. Claude drives Steward; both CLIs can be Workers.
MYCEL_CLAUDE_BIN=claude
MYCEL_CLAUDE_MODEL=
# Reserved Codex placeholders: V1 discovers `codex` from PATH and stores model
# selection on the Worker/session contract rather than reading these at startup.
MYCEL_CODEX_BIN=codex
MYCEL_CODEX_MODEL=

# Optional DingTalk application robot in Stream mode.
# Configure the complete group when using startup environment configuration.
DINGTALK_CLIENT_ID=
DINGTALK_CLIENT_SECRET=
DINGTALK_CARD_TEMPLATE_ID=
DINGTALK_ALLOWED_USER_IDS=
DINGTALK_ROBOT_CODE=

# Optional Feishu application credentials. The V1 UI stores verified values locally.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
