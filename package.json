{
  "dependencies": {
    "@alicloud/dingtalk": "^2.2.43",
    "@fastify/static": "^8.2.0",
    "dingtalk-stream": "^2.1.5",
    "dotenv": "^17.2.1",
    "fastify": "^5.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ulid": "^3.0.1",
    "zod": "^4.0.14"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.2.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.1",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "name": "mycel-local-demo",
  "private": true,
  "scripts": {
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "build:server": "tsup --config tsup.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts",
    "demo:public-reset": "node --import tsx scripts/reset-public-demo.ts",
    "demo:reset": "tsx scripts/reset-demo.ts",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch apps/server/src/index.ts\" \"vite --config apps/web/vite.config.ts\"",
    "doctor": "node --import tsx apps/server/src/doctor-cli.ts",
    "start": "npm run build && node dist/server/index.js",
    "test": "vitest run",
    "test:claude-smoke": "tsx scripts/claude-smoke.ts",
    "test:demo-e2e": "tsx scripts/demo-e2e.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "type": "module",
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
